#include "nickey44a.dtsi"

&kscan0 {
        col-gpios
            = <&xiao_d 1 GPIO_ACTIVE_HIGH>
            , <&xiao_d 2 GPIO_ACTIVE_HIGH>
            , <&xiao_d 3 GPIO_ACTIVE_HIGH>
            , <&xiao_d 4 GPIO_ACTIVE_HIGH>
            , <&xiao_d 5 GPIO_ACTIVE_HIGH>
            , <&xiao_d 6 GPIO_ACTIVE_HIGH>
            ;
};

/ {
    kscan1: kscan1 {
        compatible = "zmk,kscan-4-direction-switch";

        up-gpios    = <&gpio0 9  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        down-gpios  = <&gpio0 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        left-gpios  = <&gpio0 9  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
                      <&gpio0 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        right-gpios = <&gpio0 16 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        push-gpios  = <&gpio1 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    kscan2: kscan2 {
        compatible = "zmk,kscan-composite";
        rows = <5>;
        columns = <6>;

        matrix {
            kscan = <&kscan0>;
        };

        four_direction {
            kscan = <&kscan1>;
            row-offset = <4>;
        };
    };
};

&physical_layout0 {
    kscan = <&kscan2>;
};

&default_transform {
    rows = <5>;
    map = <
        RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                     RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
        RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                     RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
        RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(3,5)     RC(3,6) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                                        RC(3,2) RC(3,3) RC(3,4)     RC(3,7) RC(3,8) RC(3,9)
        RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4)
    >;
};

